{
  "name": "ide-dart",
  "author": "lumine-code",
  "description": "Provide Dart language intelligence through the SDK analysis server.",
  "repository": "https://github.com/lumine-code/ide-dart",
  "bugs": {
    "url": "https://github.com/lumine-code/ide-dart/issues"
  },
  "keywords": [
    "flutter",
    "pub",
    "analyzer",
    "language-server",
    "lsp",
    "refactoring"
  ],
  "version": "1.0.0",
  "license": "MIT",
  "engines": {
    "lumine": "^1.0.0"
  },
  "main": "./lib/main",
  "files": [
    "lib",
    "spec"
  ],
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "consumedServices": {
    "ide": {
      "versions": {
        "^1.0.0": "consumeIde"
      }
    }
  },
  "providedServices": {
    "background-tips.provider": {
      "versions": {
        "1.0.0": "provideBackgroundTips"
      }
    }
  },
  "specPackages": [
    "ide",
    "language-dart"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.4.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "vscode-jsonrpc": "^9.0.3"
  },
  "configSchema": {
    "serverPath": {
      "title": "Dart Path",
      "description": "Path to the project's dart executable, including Flutter's bundled Dart SDK. Leave empty for the managed SDK, DART_SDK, FLUTTER_ROOT, project FVM SDK or PATH.",
      "type": "string",
      "default": ""
    },
    "notifyWhenMissing": {
      "title": "Notify When Missing",
      "description": "Show a notification when the Dart SDK cannot be found, offering to install it.",
      "type": "boolean",
      "default": true
    },
    "features": {
      "title": "Features",
      "description": "Choose which analysis-server results the editor uses.",
      "type": "object",
      "scopeResolution": "grammar",
      "properties": {
        "diagnostics": {
          "title": "Diagnostics",
          "description": "Report syntax, type and analyzer problems.",
          "type": "boolean",
          "scopeResolution": "grammar",
          "default": true
        },
        "autocomplete": {
          "title": "Autocomplete",
          "description": "Offer completions while typing.",
          "type": "boolean",
          "scopeResolution": "grammar",
          "default": true
        },
        "hover": {
          "title": "Hover",
          "description": "Show documentation and type information.",
          "type": "boolean",
          "scopeResolution": "grammar",
          "default": true
        },
        "signature": {
          "title": "Signature Help",
          "description": "Show parameters while entering calls.",
          "type": "boolean",
          "scopeResolution": "grammar",
          "default": true
        },
        "definition": {
          "title": "Go To Definition",
          "description": "Navigate to definitions, implementations and types.",
          "type": "boolean",
          "scopeResolution": "grammar",
          "default": true
        },
        "references": {
          "title": "Find References",
          "description": "Find symbol uses.",
          "type": "boolean",
          "scopeResolution": "grammar",
          "default": true
        },
        "callHierarchy": {
          "title": "Call Hierarchy",
          "description": "Inspect incoming and outgoing calls.",
          "type": "boolean",
          "scopeResolution": "grammar",
          "default": true
        },
        "typeHierarchy": {
          "title": "Type Hierarchy",
          "description": "Inspect ancestors and descendants.",
          "type": "boolean",
          "scopeResolution": "grammar",
          "default": true
        },
        "symbols": {
          "title": "Symbols",
          "description": "Provide document and workspace symbols.",
          "type": "boolean",
          "scopeResolution": "grammar",
          "default": true
        },
        "format": {
          "title": "Format",
          "description": "Format documents, selections and typed code.",
          "type": "boolean",
          "scopeResolution": "grammar",
          "default": true
        },
        "rename": {
          "title": "Rename",
          "description": "Rename symbols and update their references.",
          "type": "boolean",
          "scopeResolution": "grammar",
          "default": true
        },
        "codeActions": {
          "title": "Code Actions",
          "description": "Apply fixes and refactorings.",
          "type": "boolean",
          "scopeResolution": "grammar",
          "default": true
        },
        "inlayHints": {
          "title": "Inlay Hints",
          "description": "Annotate inferred types and parameter names.",
          "type": "boolean",
          "scopeResolution": "grammar",
          "default": true
        },
        "semanticTokens": {
          "title": "Semantic Tokens",
          "description": "Highlight source using semantic information.",
          "type": "boolean",
          "scopeResolution": "grammar",
          "default": true
        }
      }
    },
    "onlyAnalyzeProjectsWithOpenFiles": {
      "title": "Analyze Open Projects Only",
      "description": "Analyze projects containing open files instead of all workspace folders.",
      "type": "boolean",
      "default": false
    },
    "suggestFromUnimportedLibraries": {
      "title": "Suggest Unimported Libraries",
      "description": "Include completions from libraries not yet imported, adding imports through workspace edits.",
      "type": "boolean",
      "default": true
    },
    "completeFunctionCalls": {
      "title": "Complete Function Calls",
      "description": "Complete functions and methods with their required parameters.",
      "type": "boolean",
      "default": false
    },
    "includeDependenciesInWorkspaceSymbols": {
      "title": "Include Dependency Symbols",
      "description": "Include dependency and SDK symbols in workspace symbol results.",
      "type": "boolean",
      "default": true
    },
    "showTodos": {
      "title": "Show TODO Diagnostics",
      "description": "Include TODO comments in diagnostics.",
      "type": "boolean",
      "default": false
    },
    "inlayHints": {
      "title": "Inlay Hints",
      "description": "Show the analyzer's inferred types and parameter names, matching its enabled defaults.",
      "type": "boolean",
      "default": true
    }
  }
}
